# Postgres. Any Postgres 13+ works. A URL containing neon.tech automatically
# switches the app to Neon's stateless HTTP driver (what we run on Vercel).
DATABASE_URL=postgres://localhost:5432/eventbooker

# Override the driver choice: 'pg' forces the pooled client even against Neon
# (point it at the -pooler host), 'neon' forces the HTTP driver. Leave unset to
# auto-detect. Exists so a driver problem in production is a config change.
# DB_DRIVER=pg

# Required in production -- the app refuses to boot with the dev defaults.
JWT_SECRET=change-me-to-32-plus-random-bytes
ADMIN_TOKEN=change-me-too
CRON_SECRET=change-me-for-vercel-cron

# Tuning
PG_POOL_MAX=40              # bounded on purpose; see src/config.ts
MAX_IN_FLIGHT=8192          # last-resort safety valve, not a throttle
STATEMENT_TIMEOUT_MS=3000
DEFAULT_PER_USER_LIMIT=4
MAX_SEATS_PER_REQUEST=16
SWEEP_INTERVAL_MS=5000      # local only; Vercel uses the cron in vercel.json
PORT=3000
